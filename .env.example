# Postgres connection string (Neon via the Vercel Marketplace, or any Postgres).
# Leave empty locally to use the embedded PGlite database in ./.pglite
DATABASE_URL=

# Password for /admin
ADMIN_PASSWORD=

# Random string, 32+ characters, used to sign the admin session cookie
# e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Vercel Blob read/write token (added automatically when you connect a Blob store on Vercel)
BLOB_READ_WRITE_TOKEN=

# Postgres connection string (Neon via the Vercel Marketplace, or any Postgres).
# Leave empty locally to use the embedded PGlite database in ./.pglite
DATABASE_URL=

# Google OAuth client for admin sign-in (Google Cloud → APIs & Services → Credentials).
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
#                           https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob read/write token (added automatically when you connect a Blob store on Vercel)
BLOB_READ_WRITE_TOKEN=
